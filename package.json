{
  "name": "ailiak",
  "version": "0.2.0",
  "description": "Calm CLI for ailiak.com — desk tasks from the terminal",
  "type": "module",
  "bin": {
    "ailiak": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "make": "npm run build && npm link",
    "prepare": "npm run build",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ailiak",
    "cli",
    "tasks",
    "desk"
  ],
  "author": "Angel Zaprianov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fire1/ailiak-cli.git"
  },
  "dependencies": {
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
